{
    "manifest_version": 3,
    "permissions": [
        "storage",
        "downloads"
    ],
    "background": {
        "service_worker": "background/service_worker.js"
    },
    "host_permissions": [
        "https://awbw.amarriner.com/*"
    ],
    "web_accessible_resources": [
        {
            "matches": ["https://awbw.amarriner.com/*"],
            "resources": [
                "/lib/advanced_hotkeys_compat.js",
                "/lib/co_variants.js",
                "/res/axios_throttler.js",
                "/res/calculator_reset.js",
                "/res/co_variants_patcher.js",
                "/res/game_state_reader.js",
                "/res/multihit_calculator.css",
                "/res/multihit_calculator.js",
                "/res/multihit_engine.js",
                "/res/moveplanner_menu_hook.js",
                "/res/playersinfo_patcher.js",
                "/res/savestate_injector.js",
                "/res/unitsinfo_patcher.js"
            ]
        }
    ]
}
